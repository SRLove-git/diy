# ===== 服务端环境变量（开发默认值，生产以环境注入覆盖） =====
NODE_ENV=development

# 服务
PORT=3000

# MySQL（对齐 docker/compose.dev.yml）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=diy

# Redis（对齐 docker/compose.dev.yml）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 会话与鉴权（生产务必更换）
JWT_SECRET=dev-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
# access token 有效期（默认 2h；移动端/后台自动刷新，时长影响刷新频率）
JWT_ACCESS_TTL=2h

# 聊天图片上传目录（相对进程工作目录，生产挂载持久卷）
UPLOAD_DIR=uploads

# 邮箱验证码（开发环境验证码打印在服务端日志；生产接入 SMTP 后由邮件服务发送）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DIY手作工坊 <no-reply@example.com>

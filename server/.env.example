# ===== 服务端环境变量（开发默认值，生产以环境注入覆盖） =====
NODE_ENV=development

# 服务
PORT=3000

# MySQL（对齐 docker/compose.dev.yml）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=diy

# Redis（对齐 docker/compose.dev.yml）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 会话与鉴权（生产务必更换）
JWT_SECRET=dev-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

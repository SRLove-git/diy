# =============================================================
# MySQL 8.0 生产调优配置
# 由 docker compose prod 挂载：./mysql/my.cnf -> /etc/mysql/conf.d/my.cnf
# 修改后需重建容器生效：
#   docker compose -f docker/compose.prod.yml up -d --force-recreate mysql
# 数值按服务器内存调整：innodb_buffer_pool_size 建议物理内存的 1/4 ~ 1/2
# =============================================================

[mysqld]

# ---------- 连接 ----------
# 3 个 server 副本 × 100 连接池 + 管理/监控连接；调大 DB_POOL_SIZE 时需同步放大
max_connections = 500
# 连接校验走 TCP 即可，关闭反向 DNS 解析，避免新连接卡在 DNS 上
skip-name-resolve
# 空闲连接 10 分钟回收，及时释放被占用的连接
wait_timeout = 600
interactive_timeout = 600
# 线程/表/表定义缓存，降低热连接与热表开销
thread_cache_size = 64
table_open_cache = 2048
table_open_cache_instances = 16

# ---------- InnoDB ----------
# 核心缓冲池：按物理内存 1/4 ~ 1/2 调整（4G 内存服务器推荐 1G~2G）
innodb_buffer_pool_size = 512M
# 事务日志缓冲：写入并发较高时可加大
innodb_log_buffer_size = 16M
# redo 日志总量（MySQL 8.0.30+ 参数；老版本用 innodb_log_file_size）
innodb_redo_log_capacity = 256M
# 崩溃安全：每次提交 fsync（最安全）；追求吞吐可改 2（最多丢 1 秒数据）
innodb_flush_log_at_trx_commit = 1
# Linux 生产建议 O_DIRECT，绕过系统页缓存减少双缓冲（macOS 原生 MySQL 不支持，故默认注释）
#innodb_flush_method = O_DIRECT
# 每表独立表空间，便于备份与回收
innodb_file_per_table = ON
# 排序/连接中间结果缓冲区（每会话峰值内存，不宜过大）
join_buffer_size = 4M
sort_buffer_size = 4M
# 内存临时表上限，超过自动落盘
tmp_table_size = 64M
max_heap_table_size = 64M

# ---------- 慢查询 ----------
slow_query_log = ON
long_query_time = 1
# 记录未走索引的查询，便于排查（日志较多时关闭）
log_queries_not_using_indexes = ON

# ---------- 字符集 ----------
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# ---------- 性能监控 ----------
performance_schema = ON

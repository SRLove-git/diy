# ===== 生产部署环境变量（docker compose 自动加载本目录 .env） =====
# 用法：cp docker/.env.example docker/.env 后填写真实值

# 数据库密码（首次部署前必须设置；MySQL 数据卷初始化后不可随意更改）
DB_PASSWORD=change-me

# JWT 密钥（openssl rand -hex 32 生成，两个务必不同）
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# JWT 无缝轮换：历史密钥（逗号分隔，仅验签）。
# 轮换时先把旧 JWT_SECRET/JWT_REFRESH_SECRET 填到这里，再更新上面两个并重启；
# 待旧令牌全部过期后清空
JWT_LEGACY_SECRETS=

# CORS 白名单（逗号分隔的完整来源，如 https://admin.example.com）
CORS_ORIGINS=

# 内容机审关键词（逗号分隔，管理端可运行时增删）
CONTENT_KEYWORDS=

# 生产 schema 由迁移管理：启动自动执行 migrations/
DB_MIGRATIONS_RUN=true

# 每副本 MySQL 连接池（副本数 × 池大小 ≤ max_connections=500）
DB_POOL_SIZE=100

# 每日数据库备份（backup 服务）
# 低权限备份账号（MySQL 内一次性创建，见 README；密码用 openssl rand -hex 16 生成）
BACKUP_DB_USER=backup
BACKUP_DB_PASSWORD=change-me
# 保留天数
BACKUP_RETENTION_DAYS=7
# cron 表达式（容器时区 Asia/Shanghai），默认每日凌晨 3 点
BACKUP_CRON=0 3 * * *

# nginx 反代后识别真实客户端 IP（验证码/登录按 IP 限流依赖）
TRUST_PROXY=true

# ===== 安全模块 =====

# API 全局限流（每 IP 每分钟请求数；nginx 另有 30r/s 粗粒度兜底）
THROTTLE_LIMIT=300
THROTTLE_TTL_MS=60000
THROTTLE_BLOCK_MS=300000
AUTH_THROTTLE_LIMIT=10

# 爬虫 UA 拦截（生产建议 true）
BLOCK_BOT_UA=true

# 人机验证：image（自托管 SVG 图形验证码）/ turnstile / hcaptcha / 留空关闭
CAPTCHA_PROVIDER=
# 图形验证码有效期（秒）与最大尝试次数（超过需刷新）
CAPTCHA_TTL=300
CAPTCHA_MAX_ATTEMPTS=3
TURNSTILE_SECRET=
HCAPTCHA_SECRET=

# IP 维度注册限制
REGISTER_IP_MAX=5
REGISTER_IP_WINDOW_H=24

# SMTP 邮件（验证码）：生产必须配置，未配置时验证码只打印在服务端日志
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DIY手作工坊 <no-reply@example.com>

# 对象存储：local（默认，挂载卷）或 s3（AWS S3 / MinIO / OSS / COS）
UPLOAD_PROVIDER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL_BASE=
S3_FORCE_PATH_STYLE=false

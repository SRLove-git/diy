# ===== 生产部署环境变量（docker compose 自动加载本目录 .env） =====
# 用法：cp docker/.env.example docker/.env 后填写真实值

# 数据库密码（首次部署前必须设置；MySQL 数据卷初始化后不可随意更改）
DB_PASSWORD=change-me

# JWT 密钥（openssl rand -hex 32 生成，两个务必不同）
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# CORS 白名单（逗号分隔的完整来源，如 https://admin.example.com）
CORS_ORIGINS=

# 内容机审关键词（逗号分隔，管理端可运行时增删）
CONTENT_KEYWORDS=

# 生产 schema 由迁移管理：启动自动执行 migrations/
DB_MIGRATIONS_RUN=true

# 每副本 MySQL 连接池（副本数 × 池大小 ≤ max_connections=500）
DB_POOL_SIZE=100

# nginx 反代后识别真实客户端 IP（验证码/登录按 IP 限流依赖）
TRUST_PROXY=true

# SMTP 邮件（验证码）：生产必须配置，未配置时验证码只打印在服务端日志
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DIY手作工坊 <no-reply@example.com>

# 对象存储：local（默认，挂载卷）或 s3（AWS S3 / MinIO / OSS / COS）
UPLOAD_PROVIDER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL_BASE=
S3_FORCE_PATH_STYLE=false
